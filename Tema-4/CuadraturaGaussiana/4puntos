public class Gauss4Puntos {

    public static double gauss4(double a, double b) {
        double[] x = {-0.8611363116, -0.3399810436, 0.3399810436, 0.8611363116};
        double[] w = {0.3478548451, 0.6521451549, 0.6521451549, 0.3478548451};

        double resultado = 0.0;
        for (int i = 0; i < 4; i++) {
            double xi = ((b - a) / 2) * x[i] + (a + b) / 2;
            resultado += w[i] * f(xi);
        }

        return ((b - a) / 2) * resultado;
    }

    public static double f(double x) {
        return x * x;  // Ejemplo: f(x) = x^2
    }

    public static void main(String[] args) {
        double a = 0, b = 2;
        System.out.println("Resultado (4 puntos): " + gauss4(a, b));
    }
}

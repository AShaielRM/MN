INICIO
    DEFINIR función f(x)
    ENTRAR x0 (primer valor inicial)
    ENTRAR x1 (segundo valor inicial)
    ENTRAR tolerancia
    ENTRAR máximo número de iteraciones maxIter

    i ← 0
    REPERTIR
        CALCULAR fx0 ← f(x0)
        CALCULAR fx1 ← f(x1)
        SI (fx1 - fx0) = 0 ENTONCES
            IMPRIMIR "Error: división por cero"
            SALIR
        FIN SI
        CALCULAR x2 ← x1 - fx1 * (x1 - x0) / (fx1 - fx0)
        IMPRIMIR "Iteración", i+1, ": x =", redondear(x2, 2)
        SI |x2 - x1| < tolerancia ENTONCES
            IMPRIMIR "Raíz aproximada:", redondear(x2, 2)
            SALIR
        FIN SI
        x0 ← x1
        x1 ← x2
        i ← i + 1
    HASTA i = maxIter

    IMPRIMIR "Máximo de iteraciones alcanzado sin convergencia"
FIN


public class OverflowByteLoop {
    public static void main(String[] args) {
        byte contador = 125;

        System.out.println("---- Overflow con byte ----");
        for (int i = 0; i < 5; i++) {
            System.out.println("byte contador = " + contador);
            contador++;
        }

        int contadorInt = 125;
        System.out.println("\n---- Sin overflow con int ----");
        for (int i = 0; i < 5; i++) {
            System.out.println("int contador = " + contadorInt);
            contadorInt++;
        }
    }
}
